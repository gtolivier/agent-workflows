# Local settings, read by config/settings.py and compose.yaml. Copy this
# file to .env, which git ignores: never commit it. Exported environment
# variables take precedence over .env.

# Make one: uv run python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=on
# Comma-separated. Not needed in development: with DEBUG on, Django allows
# localhost.
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com

DATABASE_URL=postgres://postgres:postgres@localhost:5432/@DB_NAME@
# The host port of compose.yaml's database: change DATABASE_URL with it.
POSTGRES_PORT=5432
